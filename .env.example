# Semua opsional. Tanpa .env pun backend tetap jalan dengan nilai bawaan.
# Dev memakai proxy /api ke localhost:8000, jadi VITE_API_URL boleh kosong.
VITE_API_URL=
PORT=8000
DB_PATH=./data/delliga.db
JWT_SECRET=ganti-dengan-rahasia-panjang
ADMIN_EMAIL=admin@delliga.test
ADMIN_PASSWORD=admin12345
SEED_DEMO=true
# Kode rahasia untuk mendaftar sebagai panitia. Kosong = pendaftaran panitia ditutup.
PANITIA_CODE=
